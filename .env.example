# Copia este archivo a .env.local y llénalo. Nunca subas .env.local al repo.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=        # publishable (sb_publishable_...) o anon
SUPABASE_SERVICE_ROLE_KEY=            # secret / service_role. SOLO servidor.

# URL pública del panel (sin "/" al final), p. ej. https://ergon-solutions.vercel.app
APP_URL=

# Cuentas del panel (las usa scripts/crear-usuarios.ts)
ADMIN_JORGE_EMAIL=
ADMIN_ANTONIO_EMAIL=
# Opcionales: si se dejan vacías, cada quien define la suya con "Olvidé mi contraseña".
ADMIN_JORGE_PASSWORD=
ADMIN_ANTONIO_PASSWORD=

# Bandeja · formulario del sitio (Fase 6)
INBOX_FORM_SECRET=

# Después
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
# Dominios que pueden mandar el formulario directo desde el navegador (CORS), separados por coma.
INBOX_FORM_ORIGINS=
# Correo (Gmail API): token de actualización de la cuenta, después de autorizarla una vez.
GMAIL_REFRESH_TOKEN=
